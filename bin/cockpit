#!/usr/bin/env bash
# cockpit — claude-launcher CLI
#
# Usage:
#   cockpit start                                 open cockpit Claude in primary terminal
#   cockpit launch <task-id> --workspace <name> --inject "<prompt>"
#                                                 spawn worker in workspace
#   cockpit status                                list active workers
#   cockpit attach <task-id>                      attach to a worker's tmux session
#   cockpit kill <task-id>                        kill a worker (or --all)
#   cockpit msg <type> ...                        worker-side inbox message
#                                                 see: cockpit msg --help
#
# Environment:
#   CLAUDE_LAUNCHER_HOME   override ~/.claude-launcher
#   CLAUDE_LAUNCHER_DEBUG  set to 1 for verbose output

set -euo pipefail

LAUNCHER_HOME="${CLAUDE_LAUNCHER_HOME:-$HOME/.claude-launcher}"
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib"
[ -d "$LIB_DIR" ] || LIB_DIR="$LAUNCHER_HOME/lib"

INBOX_DIR="$LAUNCHER_HOME/inbox"
OUTPUT_DIR="$LAUNCHER_HOME/output"
MANIFEST_FILE="$LAUNCHER_HOME/manifest.json"
WORKSPACES_DIR="$LAUNCHER_HOME/workspaces"
COCKPIT_DIR="$LAUNCHER_HOME/cockpit"
VENV_BIN_DIR="$LAUNCHER_HOME/.venv/bin"

# Eén tmux-sessie voor alles. Cockpit-Claude is window 0, workers worden window N.
# Inspired by smux (github.com/ShawnPana/smux) — single-session, no desktop clutter.
SESSION_NAME="claude-launcher"

# Default cockpit-pane breedte. Percentage zorgt dat de cockpit relatief constant
# blijft bij meer workers of een resize. Configureerbaar via env var:
#   COCKPIT_MAIN_WIDTH=70% cockpit start
MAIN_PANE_WIDTH="${COCKPIT_MAIN_WIDTH:-60%}"

# Resolve which python to use. Prefer the launcher venv (with python-docx,
# python-pptx, pyyaml installed by install.sh), else fall back to system python3.
launcher_python() {
  if [ -x "$VENV_BIN_DIR/python3" ]; then
    echo "$VENV_BIN_DIR/python3"
  elif command -v python3 >/dev/null 2>&1; then
    echo "python3"
  else
    echo ""
  fi
}

# Update de manifest met een nieuwe worker. Shared tussen single-session
# en fallback launch-paden.
update_manifest() {
  local task_id="$1" workspace="$2"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$MANIFEST_FILE" "$task_id" "$workspace" <<'PY'
import json, sys, time
manifest, task_id, workspace = sys.argv[1], sys.argv[2], sys.argv[3]
with open(manifest) as f: data = json.load(f)
data["workers"] = [w for w in data.get("workers", []) if w["task_id"] != task_id]
data["workers"].append({
    "task_id": task_id,
    "workspace": workspace,
    "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
})
with open(manifest, "w") as f: json.dump(data, f, indent=2)
PY
  fi
}

# Open a new terminal window that attaches to the given tmux session.
# Tries iTerm, then Terminal.app, then falls back to printing instructions.
open_terminal_attached() {
  local task_id="$1"
  local term_program="${TERM_PROGRAM:-}"

  # Determine target app
  local target=""
  case "$term_program" in
    iTerm.app)        target="iTerm" ;;
    Apple_Terminal)   target="Terminal" ;;
    *)
      # Fallback: try iTerm first if installed, then Terminal
      if [ -d "/Applications/iTerm.app" ]; then
        target="iTerm"
      else
        target="Terminal"
      fi
      ;;
  esac

  local attach_cmd="tmux attach -t $task_id"

  if [ "$target" = "iTerm" ]; then
    osascript <<EOF >/dev/null 2>&1 || return 1
tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "$attach_cmd"
  end tell
end tell
EOF
    return 0
  fi

  if [ "$target" = "Terminal" ]; then
    osascript <<EOF >/dev/null 2>&1 || return 1
tell application "Terminal"
  activate
  do script "$attach_cmd"
end tell
EOF
    return 0
  fi

  return 1
}

ensure_dirs() {
  mkdir -p "$INBOX_DIR" "$OUTPUT_DIR" "$WORKSPACES_DIR"
  [ -f "$MANIFEST_FILE" ] || echo '{"workers": []}' > "$MANIFEST_FILE"
}

die() {
  echo "cockpit: $1" >&2
  exit "${2:-1}"
}

debug() {
  [ "${CLAUDE_LAUNCHER_DEBUG:-0}" = "1" ] && echo "[debug] $*" >&2 || true
}

cmd_start() {
  ensure_dirs

  [ -d "$COCKPIT_DIR" ] || die "cockpit folder ontbreekt: $COCKPIT_DIR (run install.sh)"
  command -v claude >/dev/null 2>&1 || die "claude CLI niet gevonden in PATH"
  command -v tmux   >/dev/null 2>&1 || die "tmux niet geïnstalleerd"

  local require_perms=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --require-permissions) require_perms=1; shift ;;
      *) die "onbekende optie: $1" ;;
    esac
  done

  local claude_cmd="claude"
  [ "$require_perms" -eq 0 ] && claude_cmd="$claude_cmd --dangerously-skip-permissions"

  # Als de sessie al bestaat: gewoon attachen, geen nieuwe spawn
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "cockpit: sessie '$SESSION_NAME' bestaat al, attach"
    exec tmux attach-session -t "$SESSION_NAME"
  fi

  echo "cockpit: nieuwe sessie '$SESSION_NAME' in $COCKPIT_DIR"
  [ "$require_perms" -eq 0 ] && echo "  auto-approve tools: aan" || echo "  auto-approve tools: uit"

  # Maak detached sessie, één window met één pane voor de cockpit-Claude.
  # Workers worden later toegevoegd als PANES rechts via split-window + main-vertical.
  tmux new-session -d -s "$SESSION_NAME" -n "launcher" -c "$COCKPIT_DIR" -x 220 -y 50

  # Pane-labels zichtbaar in de border (top). We gebruiken een user-option @name
  # ipv pane_title omdat pane_title door Claude Code wordt overschreven met
  # zijn eigen titel ('✳ Claude Code'). @name is persistent.
  # Inspired by smux's tmux.conf.
  tmux set-option -t "$SESSION_NAME" pane-border-status top
  tmux set-option -t "$SESSION_NAME" pane-border-format ' #{?@name,#{@name},#{pane_title}} '

  # Cockpit-pane krijgt vaste breedte (default 60%, env: COCKPIT_MAIN_WIDTH).
  # main-vertical layout gebruikt main-pane-width voor de hoofdpane (links).
  tmux set-window-option -t "$SESSION_NAME" main-pane-width "$MAIN_PANE_WIDTH" 2>/dev/null || true

  # Label de eerste pane als 'cockpit' via @name
  tmux set-option -p -t "$SESSION_NAME:.0" @name "cockpit"

  # Start Claude in pane 0
  if [ -d "$VENV_BIN_DIR" ]; then
    tmux send-keys -t "$SESSION_NAME:.0" "export PATH=\"$VENV_BIN_DIR:\$PATH\"" Enter
  fi
  tmux send-keys -t "$SESSION_NAME:.0" "$claude_cmd" Enter

  # Attach — exec zodat de user volledig in de sessie zit
  exec tmux attach-session -t "$SESSION_NAME"
}

cmd_launch() {
  ensure_dirs

  local task_id="" workspace="" prompt="" wait_seconds=4 require_perms=0 headless=0
  [ $# -ge 1 ] || die "usage: cockpit launch <task-id> --workspace <name> --inject \"<prompt>\""
  task_id="$1"; shift

  while [ $# -gt 0 ]; do
    case "$1" in
      --workspace) workspace="$2"; shift 2 ;;
      --inject)    prompt="$2"; shift 2 ;;
      --wait)      wait_seconds="$2"; shift 2 ;;
      --require-permissions) require_perms=1; shift ;;
      --headless) headless=1; shift ;;
      *) die "onbekende optie: $1" ;;
    esac
  done

  [ -n "$workspace" ] || die "--workspace is verplicht"
  [ -n "$prompt" ]    || die "--inject is verplicht"

  local ws_dir="$WORKSPACES_DIR/$workspace"
  [ -d "$ws_dir" ] || die "workspace bestaat niet: $ws_dir"

  command -v claude >/dev/null 2>&1 || die "claude CLI niet gevonden in PATH"
  command -v tmux   >/dev/null 2>&1 || die "tmux niet geïnstalleerd"

  local claude_cmd="claude"
  [ "$require_perms" -eq 0 ] && claude_cmd="$claude_cmd --dangerously-skip-permissions"

  # Pre-create inbox VOORDAT we spawnen. Voorkomt race-condition met
  # file-watchers (Monitor / tail -F) die anders een leeg bestand missen
  # of de file-create niet attachen voordat de worker schrijft.
  : > "$INBOX_DIR/$task_id.ndjson"

  # Auto-append .done-protocol als de orchestrator het is vergeten.
  # Dit garandeert dat workers altijd een marker schrijven als ze klaar zijn,
  # ook als de injected prompt het niet expliciet noemt. Zonder dit blok zou
  # de cockpit blijven wachten op een signaal dat nooit komt.
  if ! printf '%s' "$prompt" | grep -q '\.done'; then
    prompt="$prompt

VERPLICHT laatste actie zodra alle deliverables (blog, rapport, etc.) klaar zijn:
  echo \"<korte samenvatting van wat je opleverde>\" > \$CLAUDE_LAUNCHER_HOME/output/\$CLAUDE_LAUNCHER_TASK_ID.done

Dat .done-bestand is hoe de cockpit weet dat jij klaar bent. Sla deze stap niet over."
  fi

  # Hoofdmodus: cockpit-sessie bestaat (cockpit start is gedaan).
  # Workers worden PANES rechts van de cockpit via split-window + main-vertical
  # layout. Inspired by smux: cockpit links, alle workers stacken rechts.
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    # Conflict-check: geen pane met deze @name mag al bestaan
    if tmux list-panes -s -t "$SESSION_NAME" -F '#{@name}' 2>/dev/null | grep -qx "$task_id"; then
      die "pane '$task_id' bestaat al in sessie '$SESSION_NAME'. Kies andere task-id of: cockpit kill $task_id"
    fi

    echo "1/4  split nieuwe pane '$task_id' rechts in sessie '$SESSION_NAME'"
    # -h: horizontal split (nieuwe pane rechts van current); -P: print pane-id; -F: format
    # -t :launcher targeting de cockpit-window zodat we daar splitten, niet ergens anders
    local pane_id
    pane_id="$(tmux split-window -h -t "$SESSION_NAME:" -c "$ws_dir" -P -F '#{pane_id}')"
    [ -n "$pane_id" ] || die "split-window faalde"

    # Label de nieuwe pane via @name (persistent, niet override-baar door Claude)
    tmux set-option -p -t "$pane_id" @name "$task_id"

    # main-vertical: cockpit (eerste pane) links groot, workers stacken rechts.
    # Re-apply main-pane-width voor het geval de user de terminal resizede sinds
    # cockpit start, of voor een nieuwe sessie zonder eerder gezette option.
    tmux set-window-option -t "$SESSION_NAME" main-pane-width "$MAIN_PANE_WIDTH" 2>/dev/null || true
    tmux select-layout -t "$SESSION_NAME:" main-vertical 2>/dev/null || true

    echo "2/4  exporteer CLAUDE_LAUNCHER_TASK_ID en start Claude in pane $pane_id"
    tmux send-keys -t "$pane_id" "export CLAUDE_LAUNCHER_TASK_ID=$task_id" Enter
    tmux send-keys -t "$pane_id" "export CLAUDE_LAUNCHER_HOME=$LAUNCHER_HOME" Enter
    if [ -d "$VENV_BIN_DIR" ]; then
      tmux send-keys -t "$pane_id" "export PATH=\"$VENV_BIN_DIR:\$PATH\"" Enter
    fi
    tmux send-keys -t "$pane_id" "$claude_cmd" Enter

    echo "3/4  wacht ${wait_seconds}s op Claude startup"
    sleep "$wait_seconds"

    echo "4/4  inject prompt in pane '$task_id'"
    local tmp_prompt
    tmp_prompt="$(mktemp -t cockpit-prompt-XXXX)"
    printf '%s' "$prompt" > "$tmp_prompt"
    tmux load-buffer "$tmp_prompt"
    tmux paste-buffer -t "$pane_id"
    sleep 0.4
    tmux send-keys -t "$pane_id" Enter
    rm -f "$tmp_prompt"

    update_manifest "$task_id" "$workspace"

    echo "OK: worker '$task_id' draait als pane in sessie '$SESSION_NAME'"
    echo "    inbox: $INBOX_DIR/$task_id.ndjson"
    echo "    navigatie: Ctrl-B + pijl voor pane-switch, of: cockpit attach $task_id"
    return 0
  fi

  # Fallback: cockpit-sessie bestaat niet. Spawn als losse sessie en open
  # in een nieuw desktop-venster (osascript). Voor wie cockpit launch zonder
  # cockpit start aanroept.
  if tmux has-session -t "$task_id" 2>/dev/null; then
    die "task-id '$task_id' bestaat al. Kies een andere of: cockpit kill $task_id"
  fi

  echo "(fallback: geen '$SESSION_NAME' sessie actief, spawn als losse sessie)"

  echo "1/4  spawn tmux '$task_id' in $ws_dir"
  tmux new-session -d -s "$task_id" -c "$ws_dir" -x 220 -y 50

  echo "2/4  exporteer CLAUDE_LAUNCHER_TASK_ID en start Claude"
  tmux send-keys -t "$task_id" "export CLAUDE_LAUNCHER_TASK_ID=$task_id" Enter
  tmux send-keys -t "$task_id" "export CLAUDE_LAUNCHER_HOME=$LAUNCHER_HOME" Enter
  if [ -d "$VENV_BIN_DIR" ]; then
    tmux send-keys -t "$task_id" "export PATH=\"$VENV_BIN_DIR:\$PATH\"" Enter
  fi
  tmux send-keys -t "$task_id" "$claude_cmd" Enter

  echo "3/4  wacht ${wait_seconds}s op Claude startup"
  sleep "$wait_seconds"

  echo "4/4  inject prompt"
  local tmp_prompt
  tmp_prompt="$(mktemp -t cockpit-prompt-XXXX)"
  printf '%s' "$prompt" > "$tmp_prompt"
  tmux load-buffer "$tmp_prompt"
  tmux paste-buffer -t "$task_id"
  sleep 0.4
  tmux send-keys -t "$task_id" Enter
  rm -f "$tmp_prompt"

  update_manifest "$task_id" "$workspace"

  echo "OK: worker '$task_id' draait als losse tmux-sessie"
  echo "    inbox: $INBOX_DIR/$task_id.ndjson"

  # Fallback-pad: cockpit-sessie ontbreekt, dus we kunnen niet als window
  # in dezelfde sessie spawnen. Open een nieuw desktop-venster via osascript.
  if [ "$headless" -eq 0 ]; then
    if open_terminal_attached "$task_id"; then
      echo "    nieuw terminal-venster geopend en attached"
    else
      echo "    visible open faalde, attach handmatig: cockpit attach $task_id"
    fi
  else
    echo "    headless, attach handmatig: cockpit attach $task_id"
  fi

  echo "  tip: voor de schoonste ervaring start eerst 'cockpit start',"
  echo "       dan worden volgende launches panes naast de cockpit"
}

cmd_status() {
  ensure_dirs

  if ! tmux ls 2>/dev/null | grep -q .; then
    echo "geen actieve tmux-sessies"
    return 0
  fi

  # Toon cockpit-sessie panes als er een claude-launcher actief is
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "sessie '$SESSION_NAME':"
    tmux list-panes -s -t "$SESSION_NAME" -F '  pane #{pane_index}: #{?@name,#{@name},#{pane_title}}  (#{pane_current_command})' 2>/dev/null
    echo
  fi

  echo "actieve workers (uit manifest):"
  printf "  %-35s  %-25s  %-25s  %s\n" "TASK-ID" "WORKSPACE" "STARTED" "INBOX"
  if command -v python3 >/dev/null 2>&1 && [ -f "$MANIFEST_FILE" ]; then
    python3 - "$MANIFEST_FILE" "$INBOX_DIR" <<'PY'
import json, os, sys
manifest, inbox_dir = sys.argv[1], sys.argv[2]
with open(manifest) as f: data = json.load(f)
for w in data.get("workers", []):
    inbox = os.path.join(inbox_dir, w["task_id"] + ".ndjson")
    n = 0
    if os.path.exists(inbox):
        with open(inbox) as fh: n = sum(1 for _ in fh)
    print(f"  {w['task_id']:<35}  {w['workspace']:<25}  {w['started_at']:<25}  {n} events")
PY
  fi
}

cmd_attach() {
  [ $# -ge 1 ] || die "usage: cockpit attach <task-id>"
  local task_id="$1"

  # Hoofdmodus: task-id is een pane (gelabeld via @name) in de cockpit-sessie
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    local pane_id
    pane_id="$(tmux list-panes -s -t "$SESSION_NAME" -F '#{pane_id} #{@name}' 2>/dev/null \
               | awk -v t="$task_id" '$2==t {print $1; exit}')"
    if [ -n "$pane_id" ]; then
      # Al binnen tmux: select-pane direct
      if [ -n "${TMUX:-}" ]; then
        exec tmux select-pane -t "$pane_id"
      fi
      # Anders attach + select-pane
      exec tmux attach -t "$SESSION_NAME" \; select-pane -t "$pane_id"
    fi
  fi

  # Fallback: task-id is een losse sessie (oude pad)
  if tmux has-session -t "$task_id" 2>/dev/null; then
    exec tmux attach -t "$task_id"
  fi

  die "geen pane of sessie gevonden voor '$task_id'"
}

cmd_kill() {
  ensure_dirs
  [ $# -ge 1 ] || die "usage: cockpit kill <task-id> | --all"

  # Kill een specifieke worker: eerst kijken of het een pane in de cockpit-sessie is,
  # anders fallback op losse sessie.
  kill_one() {
    local tid="$1"
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
      local pane_id
      pane_id="$(tmux list-panes -s -t "$SESSION_NAME" -F '#{pane_id} #{@name}' 2>/dev/null \
                 | awk -v t="$tid" '$2==t {print $1; exit}')"
      if [ -n "$pane_id" ]; then
        tmux kill-pane -t "$pane_id" 2>/dev/null && echo "killed pane: $tid"
        # Re-tile zodat overgebleven panes zich herverdelen (cockpit blijft op MAIN_PANE_WIDTH)
        tmux set-window-option -t "$SESSION_NAME" main-pane-width "$MAIN_PANE_WIDTH" 2>/dev/null || true
        tmux select-layout -t "$SESSION_NAME:" main-vertical 2>/dev/null || true
        return
      fi
    fi
    if tmux has-session -t "$tid" 2>/dev/null; then
      tmux kill-session -t "$tid" 2>/dev/null && echo "killed session: $tid"
    else
      echo "(geen pane of sessie '$tid' actief)"
    fi
  }

  if [ "$1" = "--all" ]; then
    if command -v python3 >/dev/null 2>&1 && [ -f "$MANIFEST_FILE" ]; then
      python3 - "$MANIFEST_FILE" <<'PY' | while read -r tid; do
import json, sys
with open(sys.argv[1]) as f: data = json.load(f)
for w in data.get("workers", []): print(w["task_id"])
PY
        kill_one "$tid"
      done
      echo '{"workers": []}' > "$MANIFEST_FILE"
    fi
    return 0
  fi

  local task_id="$1"
  kill_one "$task_id"

  if command -v python3 >/dev/null 2>&1; then
    python3 - "$MANIFEST_FILE" "$task_id" <<'PY'
import json, sys
manifest, task_id = sys.argv[1], sys.argv[2]
with open(manifest) as f: data = json.load(f)
data["workers"] = [w for w in data.get("workers", []) if w["task_id"] != task_id]
with open(manifest, "w") as f: json.dump(data, f, indent=2)
PY
  fi
}

cmd_msg() {
  # delegate to python helper for atomic NDJSON write
  ensure_dirs
  local msg_script="$LIB_DIR/inbox.py"
  [ -f "$msg_script" ] || msg_script="$LAUNCHER_HOME/lib/inbox.py"
  [ -f "$msg_script" ] || die "inbox.py niet gevonden (verwacht in $LIB_DIR of $LAUNCHER_HOME/lib)"

  local py
  py="$(launcher_python)"
  [ -n "$py" ] || die "geen python3 gevonden"
  CLAUDE_LAUNCHER_HOME="$LAUNCHER_HOME" exec "$py" "$msg_script" "$@"
}

cmd_reflow() {
  # Herstel de main-vertical layout met cockpit op MAIN_PANE_WIDTH.
  # Handig na een terminal-resize of als de panes scheef staan.
  tmux has-session -t "$SESSION_NAME" 2>/dev/null \
    || die "geen actieve sessie '$SESSION_NAME'"

  tmux set-window-option -t "$SESSION_NAME" main-pane-width "$MAIN_PANE_WIDTH" 2>/dev/null
  tmux select-layout -t "$SESSION_NAME:" main-vertical
  echo "reflow: cockpit $MAIN_PANE_WIDTH, workers main-vertical"
}

usage() {
  cat <<'EOF'
cockpit — claude-launcher CLI

Commands:
  start [--require-permissions]                    open cockpit Claude
  launch <task-id> --workspace <ws> --inject "<p>"
         [--require-permissions] [--headless]      spawn worker
  status                                           list active workers
  attach <task-id>                                 attach to worker tmux
  kill <task-id> | --all                           kill worker(s)
  reflow                                           reset layout (main-vertical, cockpit op COCKPIT_MAIN_WIDTH)
  msg <type> [options]                             worker-side inbox event
  help                                             this message

Defaults:
  start + launch draaien standaard met
  --dangerously-skip-permissions (Claude vraagt geen tool-toestemming).
  Voeg --require-permissions toe om de prompts terug te zetten.

  Workers spawnen als panes in de claude-launcher tmux-sessie (geen
  losse desktop-vensters). Cockpit-pane krijgt vaste breedte (default
  60%), override via env: COCKPIT_MAIN_WIDTH=70% cockpit start.
  Voeg --headless toe als je de worker onzichtbaar wilt (attach later
  met 'cockpit attach <task-id>').

Worker-side msg commands:
  cockpit msg status "<text>"
  cockpit msg question "<text>" [--options "A,B,C"]
  cockpit msg deliver <path> [--format <fmt>]
  cockpit msg done "<summary>"
  cockpit msg error "<text>" [--blocking]

Run "cockpit msg --help" for details.
EOF
}

main() {
  [ $# -ge 1 ] || { usage; exit 0; }
  local subcmd="$1"; shift || true

  case "$subcmd" in
    start)   cmd_start "$@" ;;
    launch)  cmd_launch "$@" ;;
    status)  cmd_status "$@" ;;
    attach)  cmd_attach "$@" ;;
    kill)    cmd_kill "$@" ;;
    reflow)  cmd_reflow "$@" ;;
    msg)     cmd_msg "$@" ;;
    help|-h|--help) usage ;;
    *) die "onbekend command: $subcmd (zie: cockpit help)" 2 ;;
  esac
}

main "$@"
